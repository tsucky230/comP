{
  "name": "comp-vscode",
  "displayName": "comP - Code Context Engine",
  "description": "Drastically reduce input tokens and give AI agents persistent memory. A local-first code indexer with MCP support for instant context.",
  "version": "0.12.3",
  "publisher": "tsucky230",
  "license": "MIT",
  "icon": "resources/comp-icon.png",
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "ai",
    "mcp",
    "code-indexing",
    "context-engine",
    "tree-sitter",
    "code-search"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/tsucky230/comP"
  },
  "bugs": {
    "url": "https://github.com/tsucky230/comP/issues"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "chatParticipants": [
      {
        "id": "comp.chat",
        "name": "comp",
        "fullName": "comP Context Helper",
        "description": "%comp.chatParticipant.description%",
        "icon": "resources/comp-icon.png"
      }
    ],
    "commands": [
      {
        "command": "comp.setupAgents",
        "title": "comP: Setup Agents",
        "description": "Configure MCP settings for Claude Code, Cursor, Cline, etc."
      },
      {
        "command": "comp.forceReindex",
        "title": "comP: Force Re-index",
        "description": "Force complete re-indexing of the workspace"
      },
      {
        "command": "comp.generateContext",
        "title": "comP: Generate Context Capsule",
        "description": "Generate optimized context for current task"
      },
      {
        "command": "comp.showImpactGraph",
        "title": "comP: Show Impact Graph",
        "description": "Show impact analysis for symbol at cursor"
      },
      {
        "command": "comp.copyActiveFileCompressed",
        "title": "comP: Copy Active File Compressed",
        "description": "Copy current active file with AST compression (comments removed or skeletonized)"
      },
      {
        "command": "comp.exportDebugLog",
        "title": "comP: Export Debug Log",
        "description": "Open or export the session-memory.json debug log"
      },
      {
        "command": "comp.removeHistoryHooks",
        "title": "%comp.removeHistoryHooks.title%",
        "category": "comP"
      },
      {
        "command": "comp.manageMagatama",
        "title": "%comp.manageMagatama.title%",
        "category": "comP"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "comp-explorer",
          "title": "comP",
          "icon": "resources/comp-icon-activitybar.svg"
        }
      ]
    },
    "views": {
      "comp-explorer": [
        {
          "id": "comp-stats",
          "name": "Statistics",
          "type": "webview"
        }
      ]
    },
    "configuration": {
      "title": "comP",
      "properties": {
        "comp.maxContextTokens": {
          "type": "number",
          "default": 8000,
          "minimum": 1,
          "description": "Token budget run_pipeline uses when the agent passes no max_tokens. When you set it, comP writes it to .comp/config.json (default_budget_tokens), which every agent's daemon reads; clearing it removes the value comP wrote."
        },
        "comp.enableCodeLens": {
          "type": "boolean",
          "default": true,
          "description": "Show dependency counts as CodeLens above exported symbols"
        },
        "comp.autoIndex": {
          "type": "boolean",
          "default": true,
          "description": "Automatically index files on workspace open"
        },
        "comp.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Additional directory names to exclude from indexing (synced to .comp/config.json). Changes take effect after Force Re-index."
        },
        "comp.conversationRecording.enabled": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "order": 100,
          "tags": [
            "preview"
          ],
          "markdownDescription": "%comp.conversationRecording.enabled.description%"
        },
        "comp.conversationRecording.claudeCode": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "order": 101,
          "tags": [
            "preview"
          ],
          "markdownDescription": "%comp.conversationRecording.claudeCode.description%"
        },
        "comp.ruleSharing.enabled": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "order": 110,
          "tags": [
            "preview"
          ],
          "markdownDescription": "%comp.ruleSharing.enabled.description%"
        },
        "comp.indexWorkspaceFolders": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "order": 120,
          "markdownDescription": "%comp.indexWorkspaceFolders.description%"
        },
        "comp.blockHiddenHomeFolders": {
          "type": "boolean",
          "default": true,
          "scope": "machine",
          "order": 130,
          "markdownDescription": "%comp.blockHiddenHomeFolders.description%"
        },
        "comp.useWorkspaceDaemonBuild": {
          "type": "boolean",
          "default": false,
          "scope": "machine",
          "order": 140,
          "markdownDescription": "%comp.useWorkspaceDaemonBuild.description%"
        },
        "comp.magatama.manage": {
          "type": "boolean",
          "default": false,
          "scope": "machine",
          "order": 150,
          "markdownDescription": "%comp.magatama.manage.description%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run generate-icon && npm run esbuild:prod",
    "compile": "npm run generate-icon && npm run esbuild:dev",
    "watch": "npm run esbuild:dev -- --watch",
    "generate-icon": "node scripts/generate-icon.js && node scripts/generate-icon-activitybar.js",
    "esbuild:dev": "esbuild ./src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --target=node22",
    "esbuild:prod": "npm run esbuild:dev -- --minify",
    "test": "npm run test:unit",
    "test:unit": "mocha --require ts-node/register --require src/test/setup.ts \"src/**/*.test.ts\"",
    "test:coverage": "nyc npm run test:unit",
    "test:integration": "node ./out/test/runTest.js",
    "lint:md": "markdownlint-cli2 \"**/*.md\" \"!node_modules/**\" \"!temp/**\" \"!.venv/**\" \"!.comp/**\" \"!.claude/**\" \"!docs/conversation_log.md\" \"!docs/work_plan.md\"",
    "lint:md:fix": "markdownlint-cli2 \"**/*.md\" \"!node_modules/**\" \"!temp/**\" \"!.venv/**\" \"!.comp/**\" \"!.claude/**\" \"!docs/conversation_log.md\" \"!docs/work_plan.md\" --fix",
    "lint:ts": "tsc --noEmit",
    "daemon:build": "cd daemon && cargo build --release",
    "daemon:test": "cd daemon && cargo test --all -- --test-threads=1",
    "package:local": "npm run daemon:build && node scripts/package-daemon-binary.js && vsce package"
  },
  "devDependencies": {
    "@types/chai": "^4.3.11",
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.10.0",
    "@types/sinon": "^22.0.2",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.1",
    "chai": "^4.3.10",
    "esbuild": "^0.28.2",
    "husky": "^9.1.7",
    "markdownlint-cli2": "^0.24.2",
    "mocha": "^12.0.3",
    "nyc": "^18.0.0",
    "sharp": "^0.35.5",
    "sinon": "^22.1.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.3"
  }
}
